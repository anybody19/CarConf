<Page x:Class="CarConf.Views.Step5"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Step5" Height="329">
    <StackPanel Width="206" Margin="0,0,0,-13">
        <TextBlock Text=" Контактные данные" FontSize="20"/>
        <TextBlock Text="Имя" Margin="0,10,0,0"/>
        <TextBox x:Name="NameText" Width="200"/>
        <TextBlock Text="Телефон" Margin="0,10,0,0"/>
        <TextBox x:Name="PhoneText" Width="200"/>
        <TextBlock Text="Email" Margin="0,10,0,0"/>
        <TextBox x:Name="EmailText" Width="200"/>
        <Button x:Name="SubmitBtn" Content="Оформить заявку" Width="150" Margin="0,20,0,0"
                Click="Submit_Click"/>
        <TextBlock x:Name="SummaryText" FontSize="16" Margin="0,20,0,0" Height="1"/>
        <Button Content="Назад" Width="100" Click="Back_Click" Margin="0,10,0,0" Height="38"/>
    </StackPanel>
</Page>
