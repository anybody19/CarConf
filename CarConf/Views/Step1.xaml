<Page x:Class="CarConf.Views.Step1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Step1">
    <StackPanel Margin="20">
        <TextBlock Text="Шаг 1. Выбор модели и двигателя" FontSize="20"/>
        <ComboBox x:Name="ModelComboBox" Margin="0,10"/>
        <ComboBox x:Name="EngineComboBox" Margin="0,10"/>
        <Button Content="Далее" Width="100" Margin="0,20,0,0" Click="Next_Click"/>
    </StackPanel>
</Page>
