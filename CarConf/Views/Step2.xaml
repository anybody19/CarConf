<Page x:Class="CarConf.Views.Step2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Step2">
    <StackPanel Margin="20">
        <TextBlock Text="Шаг 2. Выбор цвета и опций" FontSize="20"/>
        <ComboBox x:Name="ColorComboBox" Margin="0,10"/>
        <CheckBox x:Name="Option1" Content="Кожаный салон"/>
        <CheckBox x:Name="Option2" Content="Сигнализация"/>
        <CheckBox x:Name="Option3" Content="Навигация"/>
        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button Content="Назад" Width="100" Click="Back_Click"/>
            <Button Content="Далее" Width="100" Margin="10,0,0,0" Click="Next_Click"/>
        </StackPanel>
    </StackPanel>
</Page>