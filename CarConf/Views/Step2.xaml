<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="CarConf.Views.Step2"
      Title="Step2" av:DesignWidth="234.136">
    <StackPanel Width="230" RenderTransformOrigin="0.439,0.501">
        <TextBlock Text="  Выбор цвета и опций" FontSize="20"/>
        <ComboBox x:Name="ColorComboBox" Margin="0,10"/>
        <CheckBox x:Name="Option1" Content="Кожаный салон"/>
        <CheckBox x:Name="Option2" Content="Сигнализация"/>
        <CheckBox x:Name="Option3" Content="Навигация"/>
        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button Content="Назад" Width="100" Click="Back_Click"/>
            <Button Content="Далее" Width="100" Margin="10,0,0,0" Click="Next_Click"/>
        </StackPanel>
    </StackPanel>
</Page>