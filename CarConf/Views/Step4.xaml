<Page x:Class="CarConf.Views.Step4"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Step4">
    <StackPanel Margin="20">
        <TextBlock Text="Шаг 4. Кредит" FontSize="20"/>
        <TextBlock Text="Первоначальный взнос (%)" Margin="0,10,0,0"/>
        <TextBox x:Name="InitialPaymentText" Width="100"/>
        <TextBlock Text="Срок кредита (мес.)" Margin="0,10,0,0"/>
        <TextBox x:Name="MonthsText" Width="100"/>
        <TextBlock x:Name="MonthlyText" FontSize="16" Margin="0,20,0,0"/>
        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button Content="Назад" Width="100" Click="Back_Click"/>
            <Button Content="Далее" Width="100" Margin="10,0,0,0" Click="Next_Click"/>
        </StackPanel>
    </StackPanel>
</Page>